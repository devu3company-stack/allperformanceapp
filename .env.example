# Banco de dados (Supabase Postgres)
# DATABASE_URL: pooler em transaction mode para runtime/serverless
DATABASE_URL="postgresql://postgres.project-ref:password@aws-1-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
# DIRECT_URL: pooler em session mode para operações de schema/migrations
DIRECT_URL="postgresql://postgres.project-ref:password@aws-1-us-west-2.pooler.supabase.com:5432/postgres?sslmode=require"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Next Fit API — configurada por academia diretamente no banco (tabela academias),
# mas pode ser usada aqui como fallback/teste local
NEXTFIT_API_KEY=""
NEXTFIT_ACADEMIA_ID=""
